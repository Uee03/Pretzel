#!/bin/sh
# Pre-commit checks. Enable once per clone: git config core.hooksPath .githooks
#   1. Code standards on staged C# files.
#   2. Regenerates the sample list in README.md from the package.json files and stages it.
if command -v pwsh >/dev/null 2>&1; then
    shell="pwsh"
else
    shell="powershell.exe"
fi

run() {
    "$shell" -NoProfile -ExecutionPolicy Bypass -File "$@"
}

run ".github/skills/pretzel-code-standards/scripts/Test-CodeStandards.ps1" -Staged || exit 1

# The host projects must not be committed linked to anyone's Unity Cloud project (see .gitattributes).
for settings in TestPretzel/ProjectSettings/ProjectSettings.asset Examples/SpaceInvaders/ProjectSettings/ProjectSettings.asset; do
    if git show ":$settings" 2>/dev/null \
        | grep -Eq '^  (cloudProjectId|organizationId): *[^[:space:]]'; then
        echo "$settings is staged with a Unity Cloud project link."
        echo "Run: git config filter.unity-cloud-link.clean \"sed -E 's/^(  (cloudProjectId|projectName|organizationId):)[^\\r]*/\\1 /'\""
        echo "then: git add --renormalize $settings"
        exit 1
    fi
done

# Do not stage a README.md that has unrelated unstaged edits.
if git diff --quiet -- README.md; then
    run ".github/scripts/Update-SampleCatalog.ps1" || exit 1
    git add README.md
else
    run ".github/scripts/Update-SampleCatalog.ps1" -Check || {
        echo "README.md has unstaged changes and its sample list is out of date."
        echo "Run .github/scripts/Update-SampleCatalog.ps1, stage README.md and commit again."
        exit 1
    }
fi
