#!/bin/sh
# Checks staged C# files against the Pretzel code standards. Enable once per clone: git config core.hooksPath .githooks
script=".github/skills/pretzel-code-standards/scripts/Test-CodeStandards.ps1"
if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -File "$script" -Staged
fi
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$script" -Staged
