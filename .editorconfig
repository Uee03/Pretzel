root = true

# Based on Claude/AgenticAssisstance/templates/dotnet/.editorconfig, adapted for Unity's C# 9 compiler.

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{xml,csproj,props,targets,slnx,config,nuspec}]
indent_size = 2

[*.{json,yml,yaml,asmdef,asmref}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

# Unity writes these itself; do not let editors reformat them.
[*.{meta,unity,prefab,asset,mat,anim,controller,overrideController,physicMaterial,mask,playable,scenetemplate}]
trim_trailing_whitespace = false
insert_final_newline = unset

[*.{cs,cs.txt}]
# Prefer explicit types over var
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0008.severity = warning

# Braces required on all control blocks
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning

# Unity compiles C# 9, which has no file-scoped namespaces, so block namespaces are required.
csharp_style_namespace_declarations = block_scoped:warning
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true
csharp_prefer_simple_using_statement = true:suggestion

# Encourage readonly / immutability
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# Naming: constants PascalCase (checked first), other private fields _camelCase
dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_rule.constants_pascal.symbols = constant_fields
dotnet_naming_rule.constants_pascal.style = pascal_case
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Async methods end with Async
dotnet_naming_rule.async_methods_end_in_async.severity = suggestion
dotnet_naming_rule.async_methods_end_in_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_in_async.style = end_in_async
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.end_in_async.required_suffix = Async
dotnet_naming_style.end_in_async.capitalization = pascal_case

# Adapters live in namespaces named like their library (R3, UniTask); usings outside would resolve to those namespaces.
[Packages/com.uee03.pretzel.integrations/Runtime/**/*.cs]
csharp_using_directive_placement = inside_namespace:suggestion
