.ix-bar {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 72px;
    flex-direction: row;
    justify-content: center;
}

.ix-button {
    min-width: 170px;
    margin: 0 6px;
    padding: 8px 14px;
    font-size: 17px;
    color: rgb(240, 242, 248);
    background-color: rgba(30, 36, 52, 0.85);
    border-width: 0;
    border-radius: 8px;
}

.ix-button:hover {
    background-color: rgba(70, 84, 120, 0.95);
}

.ix-status {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 14px;
    -unity-text-align: middle-center;
    font-size: 20px;
    color: rgb(255, 214, 102);
}

.ix-help {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 36px;
    -unity-text-align: middle-center;
    font-size: 14px;
    color: rgb(230, 236, 248);
}
