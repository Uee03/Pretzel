.nc-screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(24, 28, 38);
}

.nc-card {
    min-width: 420px;
    padding: 28px 36px;
    align-items: center;
    background-color: rgb(40, 46, 62);
    border-radius: 14px;
}

.nc-title {
    font-size: 44px;
    -unity-font-style: bold;
    color: rgb(255, 214, 102);
    margin-bottom: 8px;
}

.nc-hint {
    font-size: 16px;
    color: rgb(170, 178, 196);
    margin-bottom: 18px;
}

.nc-stat {
    font-size: 24px;
    color: rgb(240, 242, 248);
}

.nc-stat--minor {
    font-size: 16px;
    color: rgb(170, 178, 196);
    margin-bottom: 18px;
}

.nc-warning {
    max-width: 380px;
    white-space: normal;
    font-size: 14px;
    color: rgb(255, 150, 120);
    margin-bottom: 12px;
}

.nc-bar {
    position: absolute;
    top: 20px;
    left: 24px;
    right: 24px;
    flex-direction: row;
    justify-content: space-between;
}

.nc-button {
    min-width: 200px;
    margin: 6px 0;
    padding: 10px 18px;
    font-size: 20px;
    color: rgb(240, 242, 248);
    background-color: rgb(72, 82, 110);
    border-width: 0;
    border-radius: 10px;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.nc-button:hover {
    background-color: rgb(92, 104, 138);
}

.nc-button:active {
    scale: 0.96 0.96;
}

.nc-button--primary {
    color: rgb(30, 26, 10);
    background-color: rgb(255, 196, 64);
}

.nc-button--primary:hover {
    background-color: rgb(255, 214, 110);
}

.nc-button--huge {
    min-width: 360px;
    min-height: 160px;
    font-size: 44px;
    -unity-font-style: bold;
}

.nc-slider {
    min-width: 300px;
    margin-top: 14px;
}

.nc-toggle {
    margin-top: 6px;
}

.nc-slider .unity-base-field__label,
.nc-toggle .unity-base-field__label {
    color: rgb(200, 206, 220);
    min-width: 70px;
}

.nc-result {
    position: absolute;
}

.nc-hidden {
    display: none;
}
