.pretzel-setup {
    flex-grow: 1;
    background-color: var(--pretzel-surface);
}

/* Header */
.pretzel-setup__header {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: var(--pretzel-honey);
    border-bottom-width: 2px;
    border-bottom-color: var(--pretzel-outline);
}

.pretzel-setup__logo {
    width: 36px;
    height: 36px;
    margin-right: 10px;
}

.pretzel-setup__title {
    font-size: var(--unity-metrics-default-font_very_big_size);
    -unity-font-style: bold;
    color: var(--pretzel-outline);
}

.pretzel-setup__version {
    color: var(--pretzel-outline);
    opacity: 0.8;
}

/* Tabs */
.pretzel-setup__tabs {
    flex-grow: 1;
}

.pretzel-tab {
    flex-grow: 1;
    padding: var(--pretzel-gap);
}

/* Sections */
.pretzel-section {
    margin-bottom: var(--pretzel-gap);
    padding: var(--pretzel-gap);
    background-color: var(--pretzel-surface-raised);
    border-width: 1px;
    border-color: var(--pretzel-border);
    border-radius: var(--pretzel-radius);
}

.pretzel-section__title {
    margin-bottom: 4px;
    font-size: var(--unity-metrics-default-font_big_size);
    -unity-font-style: bold;
}

.pretzel-section__row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.pretzel-section__row > .unity-base-field {
    flex-grow: 1;
}

.pretzel-section__hint {
    margin-top: 4px;
    opacity: 0.7;
    white-space: normal;
}

.pretzel-section__action {
    margin-top: 6px;
    align-self: flex-start;
}

.pretzel-section__action--primary {
    background-color: var(--pretzel-honey);
    color: var(--pretzel-outline);
    border-color: var(--pretzel-outline);
    -unity-font-style: bold;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.pretzel-section__action--primary:hover {
    background-color: var(--pretzel-honey-deep);
}

.pretzel-section__action--danger {
    border-color: var(--pretzel-missing);
}

.pretzel-folder-list {
    margin-top: 4px;
    min-height: 120px;
    max-height: 320px;
}

.pretzel-folder-list__item {
    flex-grow: 1;
    margin: 1px 4px;
}

/* Checklist */
.pretzel-checklist__item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 3px 0;
}

.pretzel-chip {
    padding: 1px 8px;
    border-radius: 9px;
    border-width: 1px;
    font-size: var(--unity-metrics-default-font_small_size);
    -unity-font-style: bold;
}

.pretzel-chip--ok {
    color: var(--pretzel-ok);
    border-color: var(--pretzel-ok);
}

.pretzel-chip--warn {
    color: var(--pretzel-warn);
    border-color: var(--pretzel-warn);
}

.pretzel-chip--missing {
    color: var(--pretzel-missing);
    border-color: var(--pretzel-missing);
}

/* Scene templates */
.pretzel-scene-templates {
    flex-direction: row;
    flex-wrap: wrap;
}

.pretzel-scene-templates__button {
    margin-right: 6px;
    margin-top: 4px;
}

/* About */
.pretzel-about__links {
    flex-direction: row;
    flex-wrap: wrap;
}

.pretzel-about__link {
    margin-right: 6px;
    margin-top: 4px;
}
