<engine:UXML xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements">
    <engine:VisualElement name="setup-window" class="pretzel-setup">
        <engine:VisualElement class="pretzel-setup__header">
            <engine:Image name="setup-window__logo" class="pretzel-setup__logo" />
            <engine:VisualElement>
                <engine:Label text="Pretzel" class="pretzel-setup__title" />
                <engine:Label name="setup-window__version" class="pretzel-setup__version" />
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:TabView name="setup-window__tabs" class="pretzel-setup__tabs" />
        <engine:VisualElement name="setup-window__progress" class="pretzel-progress pretzel-progress--hidden">
            <engine:Label name="setup-window__progress-label" class="pretzel-progress__label" />
            <engine:VisualElement class="pretzel-progress__track">
                <engine:VisualElement name="setup-window__progress-fill" class="pretzel-progress__fill" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
