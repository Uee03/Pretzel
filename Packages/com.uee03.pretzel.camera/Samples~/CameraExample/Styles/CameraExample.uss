.cd-bar {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 40px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.cd-button {
    min-width: 110px;
    margin: 0 6px;
    padding: 8px 14px;
    font-size: 18px;
    color: rgb(240, 242, 248);
    background-color: rgba(30, 36, 52, 0.85);
    border-width: 0;
    border-radius: 8px;
}

.cd-button:hover {
    background-color: rgba(70, 84, 120, 0.95);
}

.cd-toggle {
    margin: 0 10px;
    padding: 8px 12px;
    background-color: rgba(30, 36, 52, 0.85);
    border-radius: 8px;
}

.cd-toggle .unity-label {
    color: rgb(240, 242, 248);
}

.cd-info {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 8px;
    -unity-text-align: middle-center;
    font-size: 14px;
    color: rgb(230, 236, 248);
}
