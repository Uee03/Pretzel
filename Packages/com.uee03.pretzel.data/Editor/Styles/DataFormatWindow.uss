/* Self-contained styles for the Data Format window. Surfaces and text follow the editor skin, so it works in Light and Dark. */
.data-window {
    --pretzel-honey: #FFE100;
    --pretzel-honey-deep: #FF9B00;
    --pretzel-outline: #855000;

    --pretzel-surface: var(--unity-colors-window-background);
    --pretzel-surface-raised: var(--unity-colors-box-background);
    --pretzel-border: var(--unity-colors-default-border);

    --pretzel-ok: #4FA64F;
    --pretzel-warn: var(--unity-colors-warning-text);
    --pretzel-missing: var(--unity-colors-error-text);

    --pretzel-radius: var(--unity-metrics-default-border_radius);
    --pretzel-gap: 8px;

    flex-grow: 1;
    background-color: var(--pretzel-surface);
}

/* Header */
.data-window__header {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: var(--pretzel-honey);
    border-bottom-width: 2px;
    border-bottom-color: var(--pretzel-outline);
}

.data-window__logo {
    width: 36px;
    height: 36px;
    margin-right: 10px;
}

.data-window__title {
    font-size: var(--unity-metrics-default-font_very_big_size);
    -unity-font-style: bold;
    color: var(--pretzel-outline);
}

.data-window__subtitle {
    color: var(--pretzel-outline);
    opacity: 0.8;
}

.data-window__tabs {
    flex-grow: 1;
}

/* Tabs and sections */
.pretzel-tab {
    flex-grow: 1;
    padding: var(--pretzel-gap);
}

.pretzel-section {
    margin-bottom: var(--pretzel-gap);
    padding: var(--pretzel-gap);
    background-color: var(--pretzel-surface-raised);
    border-width: 1px;
    border-color: var(--pretzel-border);
    border-radius: var(--pretzel-radius);
}

.pretzel-section__title {
    margin-bottom: 4px;
    font-size: var(--unity-metrics-default-font_big_size);
    -unity-font-style: bold;
}

.pretzel-section__row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.pretzel-section__row > .unity-base-field {
    flex-grow: 1;
}

.pretzel-section__hint {
    margin-top: 4px;
    opacity: 0.7;
    white-space: normal;
}

.pretzel-section__action {
    margin-top: 6px;
    align-self: flex-start;
}

.pretzel-section__action--primary {
    background-color: var(--pretzel-honey);
    color: var(--pretzel-outline);
    border-color: var(--pretzel-outline);
    -unity-font-style: bold;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.pretzel-section__action--primary:hover {
    background-color: var(--pretzel-honey-deep);
}

.pretzel-section__action--danger {
    border-color: var(--pretzel-missing);
}

/* Status chips */
.pretzel-chip {
    padding: 1px 8px;
    border-radius: 9px;
    border-width: 1px;
    font-size: var(--unity-metrics-default-font_small_size);
    -unity-font-style: bold;
}

.pretzel-chip--ok {
    color: var(--pretzel-ok);
    border-color: var(--pretzel-ok);
}

.pretzel-chip--warn {
    color: var(--pretzel-warn);
    border-color: var(--pretzel-warn);
}

.pretzel-chip--missing {
    color: var(--pretzel-missing);
    border-color: var(--pretzel-missing);
}

/* Format picker */
.pretzel-format-picker {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.pretzel-format-picker__option {
    min-width: 96px;
    margin: 0 6px 6px 0;
    padding: 6px 10px;
    white-space: normal;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.pretzel-format-picker__option--selected {
    background-color: var(--pretzel-honey);
    color: var(--pretzel-outline);
    border-color: var(--pretzel-outline);
    -unity-font-style: bold;
}

/* Pros, cons and checklists */
.pretzel-subtitle {
    margin-top: 6px;
    -unity-font-style: bold;
}

.pretzel-subtitle--pro {
    color: var(--pretzel-ok);
}

.pretzel-subtitle--con {
    color: var(--pretzel-warn);
}

.pretzel-bullets {
    margin-top: 2px;
}

.pretzel-bullets__item {
    margin: 1px 0 1px 8px;
    white-space: normal;
}

.pretzel-section__hint--warning {
    color: var(--pretzel-warn);
    opacity: 1;
}

.pretzel-section__hint--error {
    color: var(--pretzel-missing);
    opacity: 1;
}

/* Key rows */
.pretzel-key-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 0;
}

.pretzel-key-row__name {
    min-width: 120px;
    -unity-font-style: bold;
}

.pretzel-key-row__chip {
    margin-right: 6px;
}

.pretzel-key-row__detail {
    flex-grow: 1;
    flex-shrink: 1;
    opacity: 0.7;
    white-space: normal;
}

.pretzel-button-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.pretzel-button-row > .pretzel-section__action {
    margin-right: 6px;
}

/* Text areas */
.pretzel-code-field {
    margin-top: 4px;
    min-height: 140px;
}

.pretzel-code-field--short {
    min-height: 56px;
}
