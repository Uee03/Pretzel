<engine:UXML xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements">
    <engine:ScrollView class="pretzel-tab">
        <engine:VisualElement class="pretzel-section">
            <engine:Label text="Set up DataIO in your project" class="pretzel-section__title" />
            <engine:Label class="pretzel-section__hint"
                          text="Each button below generates ProjectDataIO.cs: a small static class you call once at startup. It reads the settings asset (Format, Encryption and Keys tabs), and you can override any setting in code. Use one setup; generating the other replaces it after you confirm." />
            <engine:TextField name="setup-panel__folder" label="Output folder" />
            <engine:Label name="setup-panel__current" class="pretzel-chip" />
            <engine:Label name="setup-panel__current-detail" class="pretzel-section__hint" />
            <engine:Label name="setup-panel__result" class="pretzel-section__hint" />
        </engine:VisualElement>

        <engine:VisualElement class="pretzel-section">
            <engine:Label text="1. Plain JSON, GZip or BSON" class="pretzel-section__title" />
            <engine:Label class="pretzel-section__hint"
                          text="Readable or compact files and no key to manage. Choose this for settings, caches and saves that players may edit." />
            <engine:DropdownField name="setup-panel__plain-format" label="Format" />
            <engine:VisualElement class="pretzel-button-row">
                <engine:Button name="setup-panel__plain-generate" text="Generate plain / GZip / BSON setup"
                               class="pretzel-section__action pretzel-section__action--primary" />
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="pretzel-section">
            <engine:Label text="2. Encryption (AES or RSA)" class="pretzel-section__title" />
            <engine:Label class="pretzel-section__hint"
                          text="One step: it switches the settings to Encrypted, creates an AES key if there is none, exports the key the game will read, sets the key source to match, and generates ProjectDataIO.cs. For RSA, generate the key pair on the Encryption tab first." />
            <engine:DropdownField name="setup-panel__mode" label="Encryption" />
            <engine:DropdownField name="setup-panel__delivery" label="Key delivery" />
            <engine:HelpBox name="setup-panel__encryption-note" message-type="Info" />
            <engine:VisualElement class="pretzel-button-row">
                <engine:Button name="setup-panel__encrypted-generate" text="Generate AES / RSA encryption setup"
                               class="pretzel-section__action pretzel-section__action--primary" />
            </engine:VisualElement>
        </engine:VisualElement>

        <engine:VisualElement class="pretzel-section">
            <engine:Label text="Optional" class="pretzel-section__title" />
            <engine:Label class="pretzel-section__hint"
                          text="Examples add a save service and a demo component that use ProjectDataIO, plus a short guide (and a text encrypt / decrypt demo when the setup is encrypted). Existing files are never replaced. Check build setup runs the same validation as a build." />
            <engine:VisualElement class="pretzel-button-row">
                <engine:Button name="setup-panel__examples" text="Add examples" class="pretzel-section__action" />
                <engine:Button name="setup-panel__validate" text="Check build setup" class="pretzel-section__action" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:ScrollView>
</engine:UXML>
