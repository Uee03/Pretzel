/* Default look of the developer console controls. Assign your own StyleSheet on DeveloperConsole to replace it. */

.pretzel-dev-console .unity-label {
    color: rgb(225, 228, 236);
}

.pretzel-dev-console .unity-button {
    color: rgb(225, 228, 236);
    background-color: rgb(46, 48, 60);
    border-color: rgb(80, 84, 100);
}

.pretzel-dev-console .unity-button:hover {
    background-color: rgb(62, 66, 82);
}

.pretzel-dev-console__input .unity-base-text-field__input {
    color: rgb(240, 242, 248);
    background-color: rgb(22, 23, 30);
    border-color: rgb(80, 84, 100);
}
