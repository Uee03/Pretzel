.options-menu {
    align-self: center;
    margin-top: 24px;
    width: 460px;
    max-height: 90%;
    padding: 16px;
    border-radius: 8px;
    background-color: rgba(30, 30, 36, 0.95);
    color: rgb(235, 235, 235);
}

.options-menu__title {
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.options-menu__scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.options-menu__section {
    margin-bottom: 8px;
    padding: 8px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.05);
}

.options-menu__buttons {
    flex-direction: row;
    margin-top: 8px;
}

.options-menu__button {
    flex-grow: 1;
}

.options-menu__status {
    margin-top: 6px;
    min-height: 18px;
    color: rgb(255, 205, 90);
}
