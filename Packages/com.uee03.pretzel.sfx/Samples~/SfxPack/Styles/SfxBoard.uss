.sb-screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(24, 28, 38);
}

.sb-title {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(255, 214, 102);
    margin-bottom: 18px;
}

.sb-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 860px;
}

.sb-button {
    min-width: 190px;
    margin: 5px;
    padding: 10px 14px;
    font-size: 18px;
    color: rgb(240, 242, 248);
    background-color: rgb(52, 62, 88);
    border-width: 0;
    border-radius: 8px;
}

.sb-button:hover {
    background-color: rgb(82, 96, 134);
}

.sb-button:active {
    background-color: rgb(255, 196, 64);
    color: rgb(30, 26, 10);
}

.sb-toggle {
    margin-top: 18px;
}

.sb-toggle .unity-label {
    color: rgb(230, 236, 248);
}

.sb-counts {
    margin-top: 10px;
    font-size: 16px;
    color: rgb(170, 178, 196);
}
