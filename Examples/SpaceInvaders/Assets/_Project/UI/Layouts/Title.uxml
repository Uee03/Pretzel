<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:pretzel="Pretzel.UI">
    <ui:Style src="../Styles/SpaceInvaders.uss" />
    <pretzel:SafeAreaElement name="safe-area" class="invaders-root">
        <ui:VisualElement class="invaders-screen">
            <ui:VisualElement class="invaders-logo" picking-mode="Ignore" />
            <ui:Label text="SPACE INVADERS" class="invaders-title" />
            <ui:Label text="A DEMO BUILT WITH PRETZEL" class="invaders-subtitle" />
            <ui:Label text="HI-SCORE" class="invaders-label invaders-label--dim" />
            <ui:Label name="high-score" text="000000" class="invaders-value" />
            <ui:Slider name="volume" label="VOLUME" low-value="0" high-value="1" value="1" class="invaders-slider" />
            <ui:Button name="play" text="PLAY" class="invaders-button" />
            <ui:Button name="coop" text="CO-OP" class="invaders-button" />
            <ui:Button name="quit" text="QUIT" class="invaders-button invaders-button--danger" />
            <ui:Label text="A / D or arrows move    Space fires    Esc pauses    ` opens the dev console" class="invaders-hint" />
        </ui:VisualElement>
    </pretzel:SafeAreaElement>
</ui:UXML>
